# ==============================================================================
# Spring Boot Backend - Production Environment Configuration Example
# ==============================================================================

# Server Port (Render/Railway/Heroku/Fly.io supplies PORT dynamically)
PORT=8088
SERVER_PORT=8088

# Cloud PostgreSQL Database Configuration
# Supports either full standard cloud URI or individual components:
# Option A: Full Cloud URI (Heroku, Railway, Render, Supabase, Neon)
DATABASE_URL=postgres://your_user:your_password@your-db-host.com:5432/retailposdb
# Option B: Standard JDBC format
# DATABASE_URL=jdbc:postgresql://your-db-host.com:5432/retailposdb
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=your_secure_db_password

# Cloud Redis Configuration (AWS ElastiCache, Upstash, Redis Cloud, Railway)
# Supports full URI (with rediss:// TLS or redis://) or individual host/port/password:
REDIS_URL=redis://default:your_redis_password@your-redis-host.com:6379
# REDIS_HOST=your-redis-host.com
# REDIS_PORT=6379
# REDIS_PASSWORD=your_secure_redis_password

# Allowed CORS Origins (Comma-separated exact origins)
CORS_ALLOWED_ORIGINS=https://final-juice-pricing-admin.vercel.app,https://final-juice-pricing.vercel.app
APP_CORS_ALLOWED_ORIGINS=https://final-juice-pricing-admin.vercel.app,https://final-juice-pricing.vercel.app

# JWT Secret Key (Production key must be at least 64 characters)
JWT_SECRET=PubExchangeSuperSecretKeyForJWTAuth2026EnterpriseProductionEngine!

# Spring Active Profile
SPRING_PROFILES_ACTIVE=prod
