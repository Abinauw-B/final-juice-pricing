# ==============================================================================
# Spring Boot Backend - Production Environment Configuration Example
# ==============================================================================

# Server Port (Render/Railway/Heroku sets PORT dynamically)
SERVER_PORT=8088

# Cloud PostgreSQL Database Configuration
# Format: jdbc:postgresql://HOST:PORT/DATABASE
DATABASE_URL=jdbc:postgresql://your-db-host.com:5432/retailposdb
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_secure_db_password

# Cloud Redis Configuration (AWS ElastiCache, Upstash, Redis Cloud)
REDIS_HOST=your-redis-host.com
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password

# Allowed CORS Origins (Comma-separated exact origins)
APP_CORS_ALLOWED_ORIGINS=https://final-juice-pricing.vercel.app,https://final-juice-pricing-admin.vercel.app,http://localhost:8000,http://localhost:8001,http://localhost:8002

# JWT Secret Key
JWT_SECRET=PubExchangeSuperSecretKeyForJWTAuth2026EnterpriseProductionEngine!

# Spring Active Profile
SPRING_PROFILES_ACTIVE=prod
