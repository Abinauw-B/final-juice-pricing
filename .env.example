# Pub Exchange Production Environment Configuration Example

# Server Configuration
SERVER_PORT=8088
TOMCAT_MAX_THREADS=300

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=retailposdb
DB_USERNAME=postgres
DB_PASSWORD=YOUR_SECURE_PRODUCTION_DB_PASSWORD_HERE

# Security & Secrets
JWT_SECRET=YOUR_PRODUCTION_HIGH_ENTROPY_JWT_SECRET_KEY_HERE_MIN_64_CHARS

# CORS & Domains
CORS_ALLOWED_ORIGINS=https://pos.pubexchange.internal,https://admin.pubexchange.internal,http://localhost:8000,http://localhost:8001

# Public Endpoint URLs for Frontends
FRONTEND_URL=https://pos.pubexchange.internal
ADMIN_URL=https://admin.pubexchange.internal
PUBLIC_API_URL=https://api.pubexchange.internal/api
PUBLIC_WS_URL=wss://api.pubexchange.internal/ws

# HikariCP Connection Pool
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=100
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=20
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=60000
